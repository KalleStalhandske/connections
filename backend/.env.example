# SQLAlchemy connection string. Swapping this to Postgres later (e.g.
# postgresql+psycopg://user:pass@host/db) is the only change needed to
# switch databases - models and endpoints don't reference SQLite directly.
DATABASE_URL=sqlite:///./connections.db

# Comma-separated list of origins allowed to call this API from the browser.
CORS_ORIGINS=http://localhost:5173
